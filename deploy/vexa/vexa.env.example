# Vexa deployment settings (M7). Copy to /opt/meetsum/vexa.env (chmod 600) and
# fill in; deploy/vexa/bootstrap.sh passes it to `docker compose --env-file`.
# Never commit the real file. Generate secrets with: openssl rand -hex 32

# Where bootstrap.sh keeps the upstream checkout.
VEXA_HOME=/opt/vexa
# Must match deploy/vexa/vexa.lock (bootstrap.sh refuses a mismatch).
VEXA_GIT_REF=v0.12.28
VEXA_GIT_SHA=f1a62fbbdfd2c98cb162582d82c31fe8102acc89

# admin-api secret; the same value signs every per-spawn MeetingToken. It can
# mint an API key for any user: the largest secret in the stack. v0.12.27+
# refuses to boot on published placeholders.
ADMIN_TOKEN=
VEXA_ADMIN_TOKEN=${ADMIN_TOKEN}
# Internal service tier (X-Internal-Secret). Must be real; there is no default.
INTERNAL_API_SECRET=
VEXA_INTERNAL_API_SECRET=${INTERNAL_API_SECRET}

# Vexa's own Postgres inside the `vexa` project (not MeetSum's database).
DB_NAME=vexa
DB_USER=postgres
DB_PASSWORD=

# Recordings in MeetSum's MinIO, dedicated bucket-scoped credentials.
# docker-compose.vexa.yml (vexa-minio-init) creates the bucket, user and policy.
VEXA_MINIO_ACCESS_KEY=vexa-recorder
VEXA_MINIO_SECRET_KEY=
VEXA_MINIO_BUCKET=vexa-recordings
# Upstream versitygw root credentials (the unused in-project store); change them.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Published images are version-pinned in vexa.lock; this only feeds upstream's
# ${IMAGE_TAG} references for services MeetSum doesn't start.
IMAGE_TAG=v0.12.28
# Bot image the runtime spawns (from vexa.lock; bootstrap.sh overrides it when
# VEXA_BUILD_BOT=1 builds vexa/vexa-bot:<sha> from the checkout).
BROWSER_IMAGE=vexaai/vexa-bot:v0.12.28@sha256:e2398bfac7fa8671c209e996bc6451598b58438c851956ec050a0300f5a5354b
VEXA_BUILD_BOT=0
# 1 = put tecnativa/docker-socket-proxy in front of the runtime (unverified, see VERIFIED.md).
VEXA_SOCKET_PROXY=0

DEFAULT_BOT_NAME=MeetSum Notetaker
VEXA_ENV=production
# Docker networks of reverse proxies in front of the gateway (none: it is internal).
GUARD_TRUSTED_PROXIES=
# The deployment's own STT is not used: MeetSum transcribes with its ASR router.
TRANSCRIBE_ENABLED=false
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
