{
  "name": "meetsum",
  "version": "0.7.0",
  "type": "module",
  "private": true,
  "bin": {
    "meetings": "bin/meetings.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --turbopack",
    "desktop:build": "tsc -p desktop-recorder/tsconfig.json",
    "desktop:dist": "npm run desktop:build && electron-builder --config electron-builder.yml",
    "desktop:dist:win": "npm run desktop:build && electron-builder --win nsis portable --config electron-builder.yml",
    "desktop:dev": "npm run desktop:build && electron desktop-recorder/dist/main/main.js",
    "desktop:start": "npm run desktop:build && electron desktop-recorder/dist/main/main.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:schema:generate": "tsx scripts/db-schema.ts generate",
    "db:schema:check": "tsx scripts/db-schema.ts check",
    "calendar:cleanup": "tsx scripts/calendar-noise-cleanup.ts",
    "media:retention": "tsx scripts/media-retention.ts",
    "media:prepare-backfill": "tsx scripts/media-prepare-backfill.ts",
    "backup:full": "sh scripts/backup-full.sh",
    "backup:restore": "sh scripts/restore-full.sh",
    "asr:evaluate": "tsx scripts/evaluate-hebrew-asr.ts",
    "vexa:configure": "tsx scripts/vexa-configure.ts",
    "bot:simulate": "tsx scripts/bot-simulate.ts",
    "llm:evaluate": "tsx scripts/evaluate-hebrew-summaries.ts",
    "search:backfill": "tsx scripts/search-backfill.ts",
    "search:vector-setup": "tsx scripts/search-vector-setup.ts",
    "search:eval": "tsx scripts/search-eval.ts",
    "search:e2e-seed": "tsx scripts/search-e2e-seed.ts",
    "integrations:fake": "tsx scripts/fake-providers.ts",
    "integrations:e2e-seed": "tsx scripts/integrations-e2e-seed.ts",
    "webhooks:schemas": "tsx scripts/generate-webhook-schemas.ts",
    "mcp": "node mcp/server.mjs",
    "worker": "tsx worker/index.ts",
    "ds:check": "node design-system/check.mjs --strict",
    "bundle:check": "node scripts/bundle-size.mjs --budget bundle-budget.json --strict",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "m9:e2e-seed": "tsx scripts/m9-e2e-seed.ts",
    "screenshots": "playwright test tests/e2e/m9-screenshots.spec.ts",
    "m10:e2e-seed": "tsx scripts/m10-e2e-seed.ts",
    "e2e:fixtures": "tsx scripts/e2e/make-audio-fixture.ts",
    "env:matrix": "tsx scripts/env-matrix.ts",
    "api:reference": "tsx scripts/api-reference.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/lib-storage": "~3.1036.0",
    "@aws-sdk/s3-request-presigner": "~3.1036.0",
    "@base-ui/react": "^1.4.0",
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/node": "10.75.3",
    "@tanstack/react-virtual": "^3.14.17",
    "bidi-js": "^1.1.0",
    "bullmq": "^5.76.1",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "embla-carousel-react": "^8.6.0",
    "googleapis": "^171.4.0",
    "input-otp": "^1.4.2",
    "ioredis": "5.10.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.20.0",
    "pino": "10.3.1",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/busboy": "^1.5.5",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "4.13.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "$postcss",
    "uuid": "^14.0.0"
  }
}
