# MeetSum — Environment Variables
#
# Copy to .env.local (dev) or .env (docker compose) and fill in real values.
# Never commit real secrets. Every variable read by the app, worker, MCP server
# and scripts is listed here; optional ones are left empty or at their default.

# --- App URLs ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
MEETINGS_APP_URL=http://127.0.0.1:3000
# Host port docker compose publishes the app on.
APP_PORT=3000

# --- Core self-hosted services ----------------------------------------------
DATABASE_URL=postgres://meetings:meetings@meetsum-postgres:5432/meetings
# "postgres" is required in production. The in-memory demo store is refused
# in production unless MEETSUM_ALLOW_DEMO_STORAGE=true (throwaway demos only).
MEETSUM_STORAGE=postgres
MEETSUM_ALLOW_DEMO_STORAGE=false
REDIS_URL=redis://meetsum-redis:6379

# Object storage (MinIO / S3). The health check also accepts MINIO_ENDPOINT or
# AWS_ENDPOINT_URL_S3 as aliases for S3_ENDPOINT.
S3_ENDPOINT=http://meetsum-minio:9000
# MINIO_ENDPOINT=
# AWS_ENDPOINT_URL_S3=
S3_REGION=us-east-1
S3_ACCESS_KEY=meetings
S3_SECRET_KEY=meetings-secret
S3_BUCKET=meeting-media

# --- Auth, API keys and secrets ---------------------------------------------
# Placeholder ("replace-with-...", "dev-secret") secrets are rejected at boot
# when NODE_ENV=production.
MEETSUM_SESSION_SECRET=replace-with-long-random-session-secret
# Bootstrap allowlist (M2): these emails always get a membership in the
# default workspace (the Workspace subject, else the first email, is its
# owner; the rest are admins). Everyone else joins by invitation only.
MEETSUM_ALLOWED_EMAILS=you@example.com
# Allow signed-in users to create additional workspaces (default false; only
# the literal value `true` enables it).
MEETSUM_ALLOW_WORKSPACE_CREATION=false
# Invitation link lifetime in hours (default 168 = 7 days).
MEETSUM_INVITE_TTL_HOURS=168
# Every API request needs credentials (session cookie or bearer key).
# Env bootstrap keys below are bound to one workspace with limited scopes;
# create further keys (read / write / admin scopes) in Settings → API keys.
MEETSUM_API_KEYS=replace-with-long-random-dev-key
MEETSUM_API_KEY=replace-with-long-random-dev-key
MEETSUM_API_KEY_HASHES=
MEETSUM_ENV_API_KEY_WORKSPACE_ID=ws_default
# Comma-separated subset of read,write,admin (default read,write).
MEETSUM_ENV_API_KEY_SCOPES=read,write

# --- Email (workspace invitations) -------------------------------------------
# auto: SMTP when SMTP_HOST is set, else Gmail via Google delegation (needs the
# gmail.send scope for MEETSUM_EMAIL_FROM), else invites are not emailed and
# admins copy the invite link instead.
MEETSUM_EMAIL_PROVIDER=auto
MEETSUM_EMAIL_FROM=
MEETSUM_EMAIL_FROM_NAME=MeetSum
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Signs outgoing webhook deliveries. Must differ from MEETSUM_SESSION_SECRET.
WEBHOOK_SIGNING_SECRET=replace-with-long-random-webhook-secret
# Outgoing webhook delivery timeout (default 10000).
MEETSUM_WEBHOOK_TIMEOUT_MS=10000
# Per-delivery retry budget and exponential backoff base for webhook.deliver jobs.
MEETSUM_WEBHOOK_MAX_ATTEMPTS=6
MEETSUM_WEBHOOK_BACKOFF_MS=30000
# Webhook targets exempt from the private-address (SSRF) guard: comma-separated
# hosts, *.suffix wildcards or CIDR ranges. Leave empty in production unless a
# receiver genuinely lives on a private network.
MEETSUM_WEBHOOK_ALLOWED_HOSTS=
# Delivery bounds: lifetime attempt cap per delivery (manual retries included),
# subscriptions notified per event, inline attempts when Redis is down, and
# outgoing request concurrency (overall and per target host).
# MEETSUM_WEBHOOK_MAX_TOTAL_ATTEMPTS=20
# MEETSUM_WEBHOOK_MAX_SUBSCRIPTIONS_PER_EVENT=50
# MEETSUM_WEBHOOK_INLINE_FALLBACK_MAX=2
# MEETSUM_WEBHOOK_CONCURRENCY=8
# MEETSUM_WEBHOOK_PER_HOST_CONCURRENCY=2
# Set to "false" to disable the built-in API rate limiter.
MEETSUM_RATE_LIMIT=true
# Number of trusted reverse proxies in front of the app; the client IP is taken
# from X-Forwarded-For that many hops from the right (default 1).
MEETSUM_TRUSTED_PROXY_HOPS=1
# Optional single header carrying the real client IP (e.g. cf-connecting-ip).
# MEETSUM_CLIENT_IP_HEADER=

# --- Google Workspace ---------------------------------------------------------
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@example.com
GOOGLE_WORKSPACE_SUBJECT=you@example.com
GOOGLE_WORKSPACE_AUTH_STRATEGY=user-oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-long-random-token-encryption-secret

# Optional domain-wide delegation fallback (when service-account keys are
# allowed). GOOGLE_WORKSPACE_SERVICE_ACCOUNT is a legacy alias for
# GOOGLE_SERVICE_ACCOUNT_EMAIL.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# (unused, reserved) Gmail push notifications via Pub/Sub — not wired yet.
# GOOGLE_PUBSUB_PROJECT_ID=
# GOOGLE_GMAIL_TOPIC=

# Google sync schedules
MEETSUM_SCHEDULE_GOOGLE_SYNC=true
MEETSUM_SCHEDULE_CALENDAR_SYNC=true
# Keep Drive manual until storage retention and import selection are tuned.
MEETSUM_SCHEDULE_DRIVE_SYNC=false
# Meet metadata polling is safe: it discovers/links artifacts but does not bulk-download media.
MEETSUM_SCHEDULE_MEET_SYNC=true
MEETSUM_CALENDAR_POLL_MINUTES=15
MEETSUM_CALENDAR_LOOKBACK_DAYS=30
MEETSUM_CALENDAR_LOOKAHEAD_DAYS=60
MEETSUM_CALENDAR_IMPORT_ALL=false
MEETSUM_CALENDAR_EXCLUDED_CALENDAR_PATTERNS=holiday,birthday,reminder,task
MEETSUM_CALENDAR_EXCLUDED_TITLE_PATTERNS=break,brunch,dinner,gym,lunch,me time,sleep,workout
MEETSUM_DRIVE_POLL_MINUTES=30
MEETSUM_DRIVE_MAX_IMPORTS_PER_POLL=2
MEETSUM_DRIVE_MAX_IMPORT_BYTES=2000000000
MEETSUM_MEET_POLL_MINUTES=30
MEETSUM_MEET_POLL_LIMIT=10
# Max transcript entries fetched per Meet transcript (default 2000).
MEETSUM_MEET_TRANSCRIPT_ENTRY_LIMIT=2000
# Gmail context import: thread search query and max threads (defaults shown
# when empty: a 90-day meeting-related query, 25 threads).
# MEETSUM_GMAIL_CONTEXT_QUERY=
MEETSUM_GMAIL_CONTEXT_LIMIT=25

# --- AI providers --------------------------------------------------------------
# Deprecated (M3): mapped onto the ASR router chain below when set.
MEETSUM_TRANSCRIPTION_PROVIDER=auto
LOCAL_TRANSCRIPTION_URL=
LOCAL_TRANSCRIPTION_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
LOCAL_TRANSCRIPTION_LANGUAGE=he
LOCAL_TRANSCRIPTION_TIMEOUT_MS=900000
# Local Whisper is transcribed in ~10-minute chunks cut at silences.
LOCAL_TRANSCRIPTION_CHUNK_MS=600000
LOCAL_TRANSCRIPTION_CHUNK_SEARCH_MS=60000
# Bearer token for a hosted OpenAI-compatible Whisper in the local slot (never
# logged). Groq free tier (docs/runbooks/free-tier-asr.md):
#   LOCAL_TRANSCRIPTION_URL=https://api.groq.com/openai
#   LOCAL_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
#   LOCAL_TRANSCRIPTION_SEND_HOTWORDS=false
# LOCAL_TRANSCRIPTION_API_KEY=
# `hotwords` is a faster-whisper extension; set false for Groq / OpenAI.
LOCAL_TRANSCRIPTION_SEND_HOTWORDS=true

# --- Hebrew ASR + diarization (M3) ---------------------------------------------
# Provider order for Hebrew / mixed meetings, and for other languages. Providers
# without credentials are skipped.
# MEETSUM_ASR_CHAIN=runpod-ivrit,modal-worker,soniox,local-whisper-chunked
# MEETSUM_ASR_CHAIN_NON_HE=soniox,runpod-ivrit,modal-worker,local-whisper-chunked
# Gemini audio stays out of the ASR chain unless opted in (LLM transcript,
# synthetic word timings).
MEETSUM_ASR_ALLOW_GEMINI=false
# GOOGLE_GEMINI_AUDIO_PRICE_PER_MTOK=
# Circuit breaker: consecutive retryable failures before a provider is skipped,
# and for how long (auth/config errors open it for 1 h).
MEETSUM_ASR_BREAKER_THRESHOLD=3
MEETSUM_ASR_BREAKER_COOLDOWN_MS=600000
# Glossary hotwords sent to the ASR model (Latin terms first).
MEETSUM_ASR_HOTWORDS_MAX_CHARS=600
MEETSUM_ASR_USE_INITIAL_PROMPT=false

# RunPod serverless (ivrit-ai worker by default; `meetsum` = our asr-worker image).
RUNPOD_API_KEY=
RUNPOD_ASR_ENDPOINT_ID=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
RUNPOD_ASR_WORKER=ivrit
RUNPOD_ASR_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
RUNPOD_ASR_MODEL_MULTILINGUAL=large-v3-turbo
RUNPOD_ASR_ENGINE=stable-whisper
# Default: max(600000, 0.5 × audio duration + 300000).
# RUNPOD_ASR_TIMEOUT_MS=
RUNPOD_ASR_POLL_INTERVAL_MS=2000
RUNPOD_PRICE_PER_SECOND=0.00019
# Raw audio bytes for the inline base64 handoff (base64 adds a third; RunPod
# rejects request bodies above ~10 MB).
RUNPOD_MAX_BLOB_BYTES=7000000

# Modal serverless (our asr-worker via asr-worker/modal_app.py; free monthly
# credit covers small workloads). URL of the deployed web app and the bearer
# token stored in its `meetsum-asr-auth` Modal Secret.
MODAL_ASR_URL=
MODAL_ASR_TOKEN=
MODAL_ASR_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
MODAL_ASR_MODEL_MULTILINGUAL=large-v3-turbo
MODAL_ASR_POLL_INTERVAL_MS=3000
# Default: max(900000, 0.5 × audio duration + 420000) (allows a cold start).
# MODAL_ASR_TIMEOUT_MS=
MODAL_ASR_SUBMIT_RETRIES=2
# GPU $/s for the cost estimate: T4 0.000164 (default), L4 0.000222.
MODAL_PRICE_PER_SECOND=0.000164
# Inline-blob limit for Modal (defaults to RUNPOD_MAX_BLOB_BYTES).
# MODAL_MAX_BLOB_BYTES=

# How audio reaches remote ASR: auto = presigned URL when S3_PUBLIC_ENDPOINT is
# set, else an inline base64 blob (≤ RUNPOD_MAX_BLOB_BYTES); presigned | blob.
MEETSUM_ASR_MEDIA_HANDOFF=auto
# Publicly reachable S3/MinIO endpoint used only for presigned handoff URLs.
# S3_PUBLIC_ENDPOINT=
MEETSUM_ASR_HANDOFF_URL_TTL_SECONDS=7200
MEETSUM_ASR_AUDIO_BITRATE=24k

# Soniox async transcription (fallback / non-Hebrew).
SONIOX_API_KEY=
SONIOX_API_BASE_URL=https://api.soniox.com
SONIOX_MODEL=stt-async-v3
SONIOX_TIMEOUT_MS=1800000
SONIOX_PRICE_PER_HOUR=0.10

# Speaker suggestions: minimum score to suggest a name; auto-confirm score
# (empty = never auto-confirm); use the Google Meet transcript timeline;
# voiceprint matching against workspace speaker profiles (collected, off).
MEETSUM_SPEAKER_SUGGEST_THRESHOLD=0.5
MEETSUM_SPEAKER_AUTO_CONFIRM_SCORE=
MEETSUM_SPEAKER_SUGGEST_USE_MEET=true
MEETSUM_VOICEPRINT_MATCHING=false
MEETSUM_VOICEPRINT_THRESHOLD=0.72
# Worker-only settings (HF_TOKEN, ASR_MODEL, DIARIZATION_MODEL, HF_HOME,
# MAX_AUDIO_BYTES) are documented in asr-worker/README.md.

# Gemini: Developer API (GOOGLE_GEMINI_API_KEY) or Vertex AI
# (GOOGLE_GENAI_USE_VERTEXAI=true + project/location/credentials).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/opt/meetsum/secrets/vertex-ai-runtime.json
GOOGLE_GEMINI_API_KEY=
# gemini-3.5-flash is deprecated (auto-routed to 3.6-flash, retiring 2026-11-19).
GOOGLE_GEMINI_AUDIO_MODEL=gemini-3.8-flash
# Canonical summary/intelligence model (also prep, follow-up, chat). GEMINI_MODEL
# is a legacy alias read only when GOOGLE_GEMINI_SUMMARY_MODEL is unset.
GOOGLE_GEMINI_SUMMARY_MODEL=gemini-3.8-flash
# GEMINI_MODEL=
# Cheap model for title/tags/type, extraction and sentiment (M5).
GOOGLE_GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# free|paid (default paid). On the free tier Google may use submitted content
# to improve its products and humans may review it; health and ops status
# show a warning whenever GEMINI_TIER=free.
GEMINI_TIER=paid
# Optional price override (USD per 1M tokens) for GOOGLE_GEMINI_SUMMARY_MODEL.
# Defaults: gemini-3.8-flash 0.75/3.75 (until 2026-12-31), flash-lite 0.30/2.50.
# GOOGLE_GEMINI_PRICE_INPUT_PER_MTOK=
# GOOGLE_GEMINI_PRICE_OUTPUT_PER_MTOK=
GOOGLE_GEMINI_INLINE_AUDIO_LIMIT_BYTES=18000000
# Gemini tuning (defaults shown).
GOOGLE_GEMINI_HTTP_TIMEOUT_MS=900000
GOOGLE_GEMINI_FILE_WAIT_MS=300000
GOOGLE_GEMINI_TRANSCRIPT_MAX_OUTPUT_TOKENS=65536
MEETSUM_GEMINI_COMPRESSED_AUDIO_BITRATE=32k
# ffmpeg transcode/compress timeout (default 900000).
MEETSUM_FFMPEG_TIMEOUT_MS=900000
LOCAL_GEMMA_URL=http://localhost:11434

# --- LLM layer (M5) ----------------------------------------------------------
# Gemini (above) is the default provider. Claude is optional: it is used only
# when ANTHROPIC_API_KEY is set (fallback under `auto`, primary when the
# workspace prefers `anthropic`). With neither key, summaries use the
# heuristic fallback (flagged in ai_runs and the summary footer).
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL_SUMMARY=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_JUDGE=claude-opus-5-5
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_TIMEOUT_MS=600000
# Server-side refusal fallbacks for Sonnet/Opus (never for batches).
ANTHROPIC_SERVER_FALLBACK=true
# auto|anthropic|gemini; the workspace setting llmProviderPreference wins.
MEETSUM_LLM_PROVIDER_DEFAULT=auto
# Route override per task, e.g. {"summary":["anthropic:claude-sonnet-5-5","gemini:gemini-3.8-flash"]}
# MEETSUM_LLM_ROUTES=
# Prompt-cache TTL for the transcript prefix: 5m|1h.
MEETSUM_LLM_CACHE_TTL=5m
# Price table override (USD per 1M tokens), e.g. {"gemini-3.8-flash":{"input":0.75,"output":3.75}}
# MEETSUM_LLM_PRICES_JSON=
# Transcripts above this estimate are summarized map-reduce over 30-minute windows.
MEETSUM_LLM_MAX_TRANSCRIPT_TOKENS=300000
MEETSUM_LLM_LANGUAGE_CHECK=true
# IANA zone for Hebrew relative due dates ("עד יום חמישי") and task due_on.
# There is no per-workspace zone yet.
MEETSUM_DEFAULT_TIMEZONE=Asia/Jerusalem
MEETSUM_SENTIMENT_ENABLED=true
MEETSUM_CLIP_MAX_MS=600000
MEETSUM_CLIP_SHARE_URL_TTL_SECONDS=600
# Eval harness (scripts/evaluate-hebrew-summaries.ts).
MEETSUM_EVAL_JUDGES=anthropic:claude-opus-5-5
MEETSUM_EVAL_MANIFEST=.secrets/llm-eval/manifest.json

# --- Search & AskMeetSum (M6) --------------------------------------------------
# Reuses the M5 keys above: GOOGLE_GEMINI_API_KEY (or the Vertex vars) for
# embeddings and chat, ANTHROPIC_* for Claude chat, MEETSUM_LLM_PROVIDER_DEFAULT,
# MEETSUM_LLM_ROUTES (task "chat") and MEETSUM_LLM_CACHE_TTL. Confirm the Gemini
# key has embedding access (and is not free tier for confidential meetings).
# Embeddings: auto|gemini|hash|none (hash is a deterministic test provider,
# disabled in production). Model and dimensions are stored on every vector
# row; changing them needs `npm run search:vector-setup -- --key` and the
# sweeper re-embeds. pgvector HNSW caps at 2000 dimensions.
MEETSUM_EMBEDDING_PROVIDER=auto
MEETSUM_EMBEDDING_MODEL=gemini-embedding-001
MEETSUM_EMBEDDING_DIMENSIONS=1536
MEETSUM_EMBEDDING_BATCH_SIZE=100
MEETSUM_EMBEDDING_CONCURRENCY=2
MEETSUM_EMBEDDING_MAX_RETRIES=5
MEETSUM_EMBEDDING_TIMEOUT_MS=30000
MEETSUM_EMBEDDING_PRICE_PER_MTOK=0.15
# Chunking and indexing (tokens; ms). Edits are debounced before re-indexing;
# the sweeper catches up on stale or failed meetings.
MEETSUM_CHUNK_MIN_TOKENS=250
MEETSUM_CHUNK_MAX_TOKENS=800
MEETSUM_CHUNK_OVERLAP_TOKENS=80
MEETSUM_INDEX_DEBOUNCE_MS=15000
MEETSUM_INDEX_SWEEP_EVERY_MS=600000
MEETSUM_INDEX_SWEEP_BATCH=50
# Hybrid search: per-leg candidate counts, weighted RRF (k and weights),
# HNSW ef_search, trigram threshold and the fused candidate cap.
MEETSUM_SEARCH_VECTOR_K=100
MEETSUM_SEARCH_FTS_K=100
MEETSUM_SEARCH_TRGM_K=50
MEETSUM_SEARCH_RRF_K=60
MEETSUM_SEARCH_WEIGHTS=vector:1,fts:1,trgm:0.5
MEETSUM_SEARCH_HNSW_EF_SEARCH=100
MEETSUM_SEARCH_TRGM_THRESHOLD=0.45
MEETSUM_SEARCH_MAX_CANDIDATES=200
# npm run search:eval uses the recorded replay unless this is 1 (needs a key).
MEETSUM_SEARCH_EVAL_LIVE=0
# AskMeetSum: retrieval budget, full-transcript mode for a single meeting up
# to this many tokens, history turns, refusal gate, output cap, daily cap per
# user, and strict citations (uncited sentences are dropped).
MEETSUM_ASK_MAX_PASSAGES=12
MEETSUM_ASK_CONTEXT_TOKENS=12000
MEETSUM_ASK_FULL_TRANSCRIPT_TOKENS=60000
MEETSUM_ASK_HISTORY_TURNS=6
MEETSUM_ASK_MIN_SIMILARITY=0.55
MEETSUM_ASK_MAX_OUTPUT_TOKENS=1500
MEETSUM_ASK_DAILY_LIMIT_PER_USER=200
MEETSUM_ASK_STRICT_CITATIONS=true
# Replay chat streams from this directory (dev/e2e only; ignored in production),
# e.g. tests/fixtures/ask/replay.
# MEETSUM_LLM_REPLAY_DIR=
# MCP server: responses longer than this are truncated (truncated: true).
MEETSUM_MCP_MAX_CHARS=50000
# Browser e2e (npm run test:e2e): base URL of the running app, and the file
# that npm run search:e2e-seed writes the seeded test credentials to
# (gitignored; never printed).
E2E_BASE_URL=http://localhost:3000
E2E_ENV_FILE=.secrets/e2e.env

# --- Worker (BullMQ) -----------------------------------------------------------
MEETSUM_WORKER_CONCURRENCY=1
MEETSUM_WORKER_LOCK_DURATION_MS=1800000
MEETSUM_WORKER_STALLED_INTERVAL_MS=60000
MEETSUM_WORKER_MAX_STALLED_COUNT=2
# BullMQ attempts per pipeline job (exponential backoff from 3s). Permanent
# failures (missing meeting/recording, no ASR provider) are never retried.
MEETSUM_JOB_ATTEMPTS=3

# --- Player & transcript (M4) ------------------------------------------------
# Media is proxied through the app (never presigned to the browser): largest
# Range chunk per response and private cache lifetime.
MEETSUM_MEDIA_MAX_RANGE_BYTES=8388608
MEETSUM_MEDIA_CACHE_MAX_AGE_SECONDS=3600
# media.prepare worker job: duration probe, waveform peaks, playback rendition.
MEETSUM_MEDIA_PREPARE=true
MEETSUM_MEDIA_PREPARE_TIMEOUT_MS=900000
# auto: transcode to AAC-LC mono .m4a unless the original is mp3/m4a/aac within
# the passthrough size; always | never.
MEETSUM_PLAYBACK_TRANSCODE=auto
MEETSUM_PLAYBACK_AUDIO_BITRATE=64k
MEETSUM_PLAYBACK_PASSTHROUGH_MAX_BYTES=104857600
MEETSUM_PEAKS_MAX_POINTS=20000
MEETSUM_PEAKS_SAMPLE_RATE=8000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Manual transcript edits: max characters per segment and revisions kept per
# segment for undo.
MEETSUM_TRANSCRIPT_EDIT_MAX_CHARS=5000
MEETSUM_TRANSCRIPT_REVISIONS_KEEP=50

# --- Meeting bot: Vexa sidecar (M7) -------------------------------------------
# Off by default: with MEETSUM_BOT_ENABLED=false the bot worker never starts,
# calendar hooks are no-ops, bot routes return 404 (the webhook 503) and the UI
# hides every bot surface. Vexa runs as its own compose project (-p vexa,
# pinned v0.12.28); see docs/runbooks/vexa.md.
MEETSUM_BOT_ENABLED=false
# Internal gateway URL only (never public), e.g. http://vexa-gateway:<port>;
# the port is verified at the tag (deploy/vexa/VERIFIED.md).
VEXA_API_URL=
VEXA_API_KEY=
# 32+ characters; HMAC-SHA256 signing secret for /api/integrations/vexa/webhook.
VEXA_WEBHOOK_SECRET=
# Optional override; defaults to NEXT_PUBLIC_APP_URL + /api/integrations/vexa/webhook.
VEXA_WEBHOOK_URL=
VEXA_WEBHOOK_ALLOW_BEARER=false
VEXA_WEBHOOK_TOLERANCE_SECONDS=300
VEXA_TIMEOUT_MS=10000
VEXA_STREAM_TIMEOUT_MS=1800000
VEXA_VERSION=0.12.28
# The bot name must signal recording.
MEETSUM_BOT_NAME=MeetSum Notetaker
# Dedicated Workspace account the bot browser profile signs in with; excluded
# from calendar participants and speaker candidates.
MEETSUM_BOT_ACCOUNT_EMAIL=
MEETSUM_BOT_PLATFORMS=google_meet,teams,zoom
MEETSUM_BOT_AUTHENTICATED=true
# Invite the bot account to events (needs the calendar.events DWD scope).
MEETSUM_BOT_CALENDAR_INVITE=false
# Comma-separated, added to workspace member domains for the external_only rule.
MEETSUM_BOT_INTERNAL_DOMAINS=
MEETSUM_BOT_DEFAULT_LEAD_SECONDS=60
MEETSUM_BOT_LATE_JOIN_MAX_MINUTES=30
MEETSUM_BOT_LEFT_ALONE_MS=600000
MEETSUM_BOT_AWAITING_ADMISSION_TIMEOUT_MINUTES=15
# Vexa transcription stays off: our ASR router produces the final transcript.
MEETSUM_BOT_TRANSCRIBE=false
# ~1 vCPU and 1 GB RAM per concurrent bot.
MEETSUM_BOT_MAX_CONCURRENT=2
MEETSUM_BOT_MAX_CONCURRENT_PER_WORKSPACE=2
MEETSUM_BOT_JOIN_RATE_PER_HOUR=20
MEETSUM_BOT_RECONCILE_SECONDS=120
MEETSUM_BOT_STALE_MINUTES=10
MEETSUM_BOT_WORKER_CONCURRENCY=4
MEETSUM_BOT_FINALIZE_ATTEMPTS=8
MEETSUM_VEXA_ARTIFACT_RETENTION_HOURS=72
# Live draft transcript (stretch; needs a Vexa STT backend).
MEETSUM_LIVE_TRANSCRIPT=false
MEETSUM_LIVE_POLL_MS=2000
MEETSUM_LIVE_MAX_STREAMS=20

# --- Uploads -------------------------------------------------------------------
# Max recording upload size (default 2 GiB) and max size of a non-file
# multipart field (default 5 MiB).
MEETSUM_MAX_UPLOAD_BYTES=2147483648
MEETSUM_MAX_UPLOAD_FIELD_BYTES=5242880
# Max Zoom/Teams cloud recording download size (defaults to MEETSUM_MAX_UPLOAD_BYTES).
# MEETSUM_MAX_RECORDING_BYTES=

# --- Meeting platform capture (webhook receivers) -----------------------------
# Zoom: Server-to-Server OAuth app + webhook secret token. Completed cloud
# recordings are downloaded into object storage and processed by the worker.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
# Microsoft Teams: Entra (Azure AD) app for Graph + the clientState used when
# creating Graph subscriptions. The worker keeps the recording subscription
# alive when these are configured.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
TEAMS_WEBHOOK_CLIENT_STATE=
# Graph resource to subscribe to (default communications/onlineMeetings/getAllRecordings).
# TEAMS_SUBSCRIPTION_RESOURCE=
TEAMS_SUBSCRIPTION_EXPIRATION_MINUTES=4200
TEAMS_SUBSCRIPTION_RENEW_BEFORE_MINUTES=720
# How often the worker checks/renews Teams subscriptions (default 360).
MEETSUM_TEAMS_SUBSCRIPTION_RENEW_MINUTES=360

# --- Automation and business systems -----------------------------------------
# Passed to the bundled n8n container as WEBHOOK_URL.
N8N_WEBHOOK_URL=http://localhost:5678/
# (unused, reserved) n8n REST API access — not wired yet.
# N8N_API_URL=http://localhost:5678/api/v1
# N8N_API_KEY=
# On the VPS, RealizeOS currently runs on the host at port 8082.
REALIZEOS_API_URL=http://host.docker.internal:8082
REALIZEOS_API_KEY=
REALIZEOS_MEETING_CONTEXT_PATH=/api/meeting-context
# Notion export takes the integration token per request only (admins); there is
# no server-wide NOTION_TOKEN fallback (it allowed cross-tenant Notion writes).

# --- docker compose infrastructure -------------------------------------------
# Read by docker-compose*.yml only. POSTGRES_PASSWORD, MINIO_ROOT_USER and
# MINIO_ROOT_PASSWORD are required by docker-compose.prod.yml.
POSTGRES_DB=meetings
POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
MINIO_ROOT_USER=meetings
MINIO_ROOT_PASSWORD=meetings-secret
# Optional host port overrides (defaults shown).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# N8N_PORT=5678
# N8N_HOST=localhost
# LOCAL_TRANSCRIPTION_PORT=8000

# --- Scripts / tooling (optional) ---------------------------------------------
# npm run asr:evaluate — manifest path (default .secrets/asr-eval/manifest.json)
# and comma-separated providers (local-whisper,gemini; default: all configured).
# MEETSUM_ASR_EVAL_MANIFEST=
# MEETSUM_ASR_EVAL_PROVIDERS=
# scripts/test-google-delegation.mjs — path to the gcloud binary.
# GCLOUD_BIN=
