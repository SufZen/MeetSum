# MeetSum — Environment Variables
#
# Copy to .env.local (dev) or .env (docker compose) and fill in real values.
# Never commit real secrets. Every variable read by the app, worker, MCP server
# and scripts is listed here; optional ones are left empty or at their default.

# --- App URLs ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
MEETINGS_APP_URL=http://127.0.0.1:3000
# Host port docker compose publishes the app on.
APP_PORT=3000

# --- Core self-hosted services ----------------------------------------------
DATABASE_URL=postgres://meetings:meetings@meetsum-postgres:5432/meetings
# "postgres" is required in production. The in-memory demo store is refused
# in production unless MEETSUM_ALLOW_DEMO_STORAGE=true (throwaway demos only).
MEETSUM_STORAGE=postgres
MEETSUM_ALLOW_DEMO_STORAGE=false
REDIS_URL=redis://meetsum-redis:6379

# Object storage (MinIO / S3). The health check also accepts MINIO_ENDPOINT or
# AWS_ENDPOINT_URL_S3 as aliases for S3_ENDPOINT.
S3_ENDPOINT=http://meetsum-minio:9000
# MINIO_ENDPOINT=
# AWS_ENDPOINT_URL_S3=
S3_REGION=us-east-1
S3_ACCESS_KEY=meetings
S3_SECRET_KEY=meetings-secret
S3_BUCKET=meeting-media

# --- Auth, API keys and secrets ---------------------------------------------
# Placeholder ("replace-with-...", "dev-secret") secrets are rejected at boot
# when NODE_ENV=production.
MEETSUM_SESSION_SECRET=replace-with-long-random-session-secret
MEETSUM_ALLOWED_EMAILS=you@example.com
MEETSUM_REQUIRE_API_KEY=true
MEETSUM_API_KEYS=replace-with-long-random-dev-key
MEETSUM_API_KEY=replace-with-long-random-dev-key
MEETSUM_API_KEY_HASHES=
# Signs outgoing webhook deliveries. Must differ from MEETSUM_SESSION_SECRET.
WEBHOOK_SIGNING_SECRET=replace-with-long-random-webhook-secret
# Outgoing webhook delivery timeout (default 10000).
MEETSUM_WEBHOOK_TIMEOUT_MS=10000
# Per-delivery retry budget and exponential backoff base for webhook.deliver jobs.
MEETSUM_WEBHOOK_MAX_ATTEMPTS=6
MEETSUM_WEBHOOK_BACKOFF_MS=30000
# Webhook targets exempt from the private-address (SSRF) guard: comma-separated
# hosts, *.suffix wildcards or CIDR ranges. Leave empty in production unless a
# receiver genuinely lives on a private network.
MEETSUM_WEBHOOK_ALLOWED_HOSTS=
# Set to "false" to disable the built-in API rate limiter.
MEETSUM_RATE_LIMIT=true
# Number of trusted reverse proxies in front of the app; the client IP is taken
# from X-Forwarded-For that many hops from the right (default 1).
MEETSUM_TRUSTED_PROXY_HOPS=1
# Optional single header carrying the real client IP (e.g. cf-connecting-ip).
# MEETSUM_CLIENT_IP_HEADER=

# --- Google Workspace ---------------------------------------------------------
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@example.com
GOOGLE_WORKSPACE_SUBJECT=you@example.com
GOOGLE_WORKSPACE_AUTH_STRATEGY=user-oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-long-random-token-encryption-secret

# Optional domain-wide delegation fallback (when service-account keys are
# allowed). GOOGLE_WORKSPACE_SERVICE_ACCOUNT is a legacy alias for
# GOOGLE_SERVICE_ACCOUNT_EMAIL.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# (unused, reserved) Gmail push notifications via Pub/Sub — not wired yet.
# GOOGLE_PUBSUB_PROJECT_ID=
# GOOGLE_GMAIL_TOPIC=

# Google sync schedules
MEETSUM_SCHEDULE_GOOGLE_SYNC=true
MEETSUM_SCHEDULE_CALENDAR_SYNC=true
# Keep Drive manual until storage retention and import selection are tuned.
MEETSUM_SCHEDULE_DRIVE_SYNC=false
# Meet metadata polling is safe: it discovers/links artifacts but does not bulk-download media.
MEETSUM_SCHEDULE_MEET_SYNC=true
MEETSUM_CALENDAR_POLL_MINUTES=15
MEETSUM_CALENDAR_LOOKBACK_DAYS=30
MEETSUM_CALENDAR_LOOKAHEAD_DAYS=60
MEETSUM_CALENDAR_IMPORT_ALL=false
MEETSUM_CALENDAR_EXCLUDED_CALENDAR_PATTERNS=holiday,birthday,reminder,task
MEETSUM_CALENDAR_EXCLUDED_TITLE_PATTERNS=break,brunch,dinner,gym,lunch,me time,sleep,workout
MEETSUM_DRIVE_POLL_MINUTES=30
MEETSUM_DRIVE_MAX_IMPORTS_PER_POLL=2
MEETSUM_DRIVE_MAX_IMPORT_BYTES=2000000000
MEETSUM_MEET_POLL_MINUTES=30
MEETSUM_MEET_POLL_LIMIT=10
# Max transcript entries fetched per Meet transcript (default 2000).
MEETSUM_MEET_TRANSCRIPT_ENTRY_LIMIT=2000
# Gmail context import: thread search query and max threads (defaults shown
# when empty: a 90-day meeting-related query, 25 threads).
# MEETSUM_GMAIL_CONTEXT_QUERY=
MEETSUM_GMAIL_CONTEXT_LIMIT=25

# --- AI providers --------------------------------------------------------------
# Auto tries local ivrit-ai ASR for Hebrew/mixed meetings and falls back to Gemini.
MEETSUM_TRANSCRIPTION_PROVIDER=auto
LOCAL_TRANSCRIPTION_URL=
LOCAL_TRANSCRIPTION_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
LOCAL_TRANSCRIPTION_LANGUAGE=he
LOCAL_TRANSCRIPTION_TIMEOUT_MS=900000

# Gemini: Developer API (GOOGLE_GEMINI_API_KEY) or Vertex AI
# (GOOGLE_GENAI_USE_VERTEXAI=true + project/location/credentials).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/opt/meetsum/secrets/vertex-ai-runtime.json
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_AUDIO_MODEL=gemini-3.5-flash
# Canonical summary/intelligence model. GEMINI_MODEL is a legacy alias read
# only when GOOGLE_GEMINI_SUMMARY_MODEL is unset.
GOOGLE_GEMINI_SUMMARY_MODEL=gemini-3.5-flash
# GEMINI_MODEL=
GOOGLE_GEMINI_INLINE_AUDIO_LIMIT_BYTES=18000000
# Gemini tuning (defaults shown).
GOOGLE_GEMINI_HTTP_TIMEOUT_MS=900000
GOOGLE_GEMINI_FILE_WAIT_MS=300000
GOOGLE_GEMINI_TRANSCRIPT_MAX_OUTPUT_TOKENS=65536
MEETSUM_GEMINI_COMPRESSED_AUDIO_BITRATE=32k
# ffmpeg transcode/compress timeout (default 900000).
MEETSUM_FFMPEG_TIMEOUT_MS=900000
LOCAL_GEMMA_URL=http://localhost:11434

# --- Worker (BullMQ) -----------------------------------------------------------
MEETSUM_WORKER_CONCURRENCY=1
MEETSUM_WORKER_LOCK_DURATION_MS=1800000
MEETSUM_WORKER_STALLED_INTERVAL_MS=60000
MEETSUM_WORKER_MAX_STALLED_COUNT=2
# BullMQ attempts per pipeline job (exponential backoff from 3s). Permanent
# failures (missing meeting/recording, no ASR provider) are never retried.
MEETSUM_JOB_ATTEMPTS=3

# --- Uploads -------------------------------------------------------------------
# Max recording upload size (default 2 GiB) and max size of a non-file
# multipart field (default 5 MiB).
MEETSUM_MAX_UPLOAD_BYTES=2147483648
MEETSUM_MAX_UPLOAD_FIELD_BYTES=5242880
# Max Zoom/Teams cloud recording download size (defaults to MEETSUM_MAX_UPLOAD_BYTES).
# MEETSUM_MAX_RECORDING_BYTES=

# --- Meeting platform capture (webhook receivers) -----------------------------
# Zoom: Server-to-Server OAuth app + webhook secret token. Completed cloud
# recordings are downloaded into object storage and processed by the worker.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
# Microsoft Teams: Entra (Azure AD) app for Graph + the clientState used when
# creating Graph subscriptions. The worker keeps the recording subscription
# alive when these are configured.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
TEAMS_WEBHOOK_CLIENT_STATE=
# Graph resource to subscribe to (default communications/onlineMeetings/getAllRecordings).
# TEAMS_SUBSCRIPTION_RESOURCE=
TEAMS_SUBSCRIPTION_EXPIRATION_MINUTES=4200
TEAMS_SUBSCRIPTION_RENEW_BEFORE_MINUTES=720
# How often the worker checks/renews Teams subscriptions (default 360).
MEETSUM_TEAMS_SUBSCRIPTION_RENEW_MINUTES=360

# --- Automation and business systems -----------------------------------------
# Passed to the bundled n8n container as WEBHOOK_URL.
N8N_WEBHOOK_URL=http://localhost:5678/
# (unused, reserved) n8n REST API access — not wired yet.
# N8N_API_URL=http://localhost:5678/api/v1
# N8N_API_KEY=
# On the VPS, RealizeOS currently runs on the host at port 8082.
REALIZEOS_API_URL=http://host.docker.internal:8082
REALIZEOS_API_KEY=
REALIZEOS_MEETING_CONTEXT_PATH=/api/meeting-context
# Default Notion integration token for meeting export (can also be passed per request).
NOTION_TOKEN=

# --- docker compose infrastructure -------------------------------------------
# Read by docker-compose*.yml only. POSTGRES_PASSWORD, MINIO_ROOT_USER and
# MINIO_ROOT_PASSWORD are required by docker-compose.prod.yml.
POSTGRES_DB=meetings
POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
MINIO_ROOT_USER=meetings
MINIO_ROOT_PASSWORD=meetings-secret
# Optional host port overrides (defaults shown).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# N8N_PORT=5678
# N8N_HOST=localhost
# LOCAL_TRANSCRIPTION_PORT=8000

# --- Scripts / tooling (optional) ---------------------------------------------
# npm run asr:evaluate — manifest path (default .secrets/asr-eval/manifest.json)
# and comma-separated providers (local-whisper,gemini; default: all configured).
# MEETSUM_ASR_EVAL_MANIFEST=
# MEETSUM_ASR_EVAL_PROVIDERS=
# scripts/test-google-delegation.mjs — path to the gcloud binary.
# GCLOUD_BIN=
